# ============== Server ==============
NODE_ENV=development
PORT=3000
HOST=localhost

# ============== Database (PostgreSQL + PostGIS) ==============
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/china_history_map
PG_POOL_MAX=10
PG_POOL_MIN=2
PG_POOL_IDLE_TIMEOUT=30000

# ============== JWT (use strong random secrets, >=32 chars) ==============
JWT_ACCESS_SECRET=replace-with-strong-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-strong-random-secret-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_DOMAIN=localhost
JWT_REFRESH_COOKIE_PATH=/

# ============== CORS (comma-separated allowed origins) ==============
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
CORS_CREDENTIALS=true

# ============== Client URL (for emails / redirects) ==============
CLIENT_URL=http://localhost:5173

# ============== Logging ==============
LOG_LEVEL=info

# ============== Rate limit ==============
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
